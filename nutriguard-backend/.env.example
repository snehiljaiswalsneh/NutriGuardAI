# =====================================================================
# NutriGuard AI Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.
# =====================================================================

# --- App ---
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1
LOG_LEVEL=debug

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWKS/issuer used to verify Supabase-issued JWTs without a network round-trip per request
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Database (Drizzle / postgres-js) ---
# Use the Supabase "Session pooler" connection string for migrations,
# and the "Transaction pooler" string for the running application (see README).
DATABASE_URL=postgresql://postgres:password@localhost:5432/nutriguard
DATABASE_POOL_MAX=10

# --- AI Providers ---
GEMINI_API_KEY=AIzaSy...
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
NVIDIA_API_KEY=nvapi-...
AI_PRIMARY_MODEL=gemini-3.5-flash
AI_SECONDARY_MODEL=meta/llama-3.1-70b-instruct

# --- Security ---
# Comma-separated list of allowed origins. For production on Vercel, add your
# deployed frontend URL (e.g. https://nutriguard-frontend.vercel.app).
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://nutriguard.ai
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX_REQUESTS=300

# --- Feature Flags (see src/shared/config/feature-flags.ts) ---
FEATURE_OCR_ENABLED=false
FEATURE_BARCODE_ENABLED=false
FEATURE_VOICE_ENABLED=false
