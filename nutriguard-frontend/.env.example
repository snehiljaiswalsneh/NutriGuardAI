# =====================================================================
# NutriGuard AI Frontend — Environment Variables Template
# Copy to .env and fill in real values. Never commit .env to git.
# =====================================================================

# The base URL pointing to the running backend API instance
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Supabase project endpoint — safe to expose to browser client
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase public client token — safe to expose to browser client
VITE_SUPABASE_ANON_KEY=your-anon-key

# Continue with Google uses supabase.auth.signInWithOAuth({ provider: 'google' }).
# After filling the values above, enable Google under Authentication > Providers
# and add http://localhost:5173/auth/callback to Redirect URLs.
